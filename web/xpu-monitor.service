[Unit]
Description=XPU Cluster Resource Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=CHANGE_ME/web
ExecStart=/path/to/node server/proxy.cjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xpu-monitor

[Install]
WantedBy=multi-user.target
